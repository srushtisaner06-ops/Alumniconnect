# Copy to .env (or export these) before deploying. Everything has a dev default.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_EMAIL=admin@vit.edu
ADMIN_PASSWORD=change-me
PUBLIC_URL=http://localhost:5173          # base URL used in alumni links
CORS_ORIGINS=http://localhost:5173
AUTOLOAD_REFERENCE=1                      # on an EMPTY database, load data/reference_placement.xlsx once

# Leave SMTP_HOST / TELEGRAM_BOT_TOKEN empty = simulated mode (logs only, nobody is contacted)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alumni@vit.edu
TELEGRAM_BOT_TOKEN=
WORKER_TICK_SECONDS=30
