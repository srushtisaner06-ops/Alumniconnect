# Copy to .env (or export these) before deploying. Everything has a dev default.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_EMAIL=admin@vit.edu
ADMIN_PASSWORD=change-me
PUBLIC_URL=http://localhost:5173          # base URL used in alumni links
CORS_ORIGINS=http://localhost:5173
AUTOLOAD_REFERENCE=1                      # on an EMPTY database, load data/reference_placement.xlsx once

# Leave SMTP_HOST / TELEGRAM_BOT_TOKEN empty = simulated mode (logs only, nobody is contacted)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alumni@vit.edu
TELEGRAM_BOT_TOKEN=
WORKER_TICK_SECONDS=30

# ---- Phase 0: security (all optional; shown with their defaults)
APP_ENV=production                      # "production" refuses to start with the dev SECRET_KEY / ADMIN_PASSWORD / CORS '*'
MIN_PASSWORD_LENGTH=10
LOCKOUT_THRESHOLD=5                       # wrong passwords in a row before an account locks
LOCKOUT_MINUTES=15
RESET_TOKEN_MINUTES=60
TOKEN_TTL_DAYS=30                         # alumni links expire after this; every reminder renews it
RATE_LIMIT_ENABLED=1
TRUST_PROXY_HOPS=2                       # proxies in front of the API. ngrok -> Vite -> API = 2. 0 = ignore X-Forwarded-For
STORAGE_BACKEND=local
STORAGE_ROOT=                             # default: backend/data/private_files (never served over HTTP)
MAX_DOCUMENT_BYTES=5242880

# ---- Phase 1: proof of career + income range on the alumni form
REQUIRE_PROOF=1                           # form must include an uploaded proof (set 0 for a soft rollout)
REQUIRE_INCOME_RANGE=1                    # form must include an income range
MAX_PROOFS_PER_ALUMNI=10
